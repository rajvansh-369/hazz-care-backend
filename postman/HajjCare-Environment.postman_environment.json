{
  "id": "hajjcare-local-docker-env",
  "name": "HajjCare - Local Docker",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "mailpitUrl",
      "value": "http://localhost:8025",
      "type": "default",
      "enabled": true
    },
    {
      "key": "rcWebhookSecret",
      "value": "local-only-placeholder-rc-webhook-secret-0000",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
