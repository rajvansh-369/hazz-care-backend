# HajjCare API — copy to .env and fill in. Validated at boot by src/config/config.js;
# the process refuses to start on a missing secret or an out-of-range value.

NODE_ENV=development
PORT=5000
# Routes are mounted here; the base URL given to the Flutter app is https://<host>/api/v1
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=*
# Number of reverse-proxy hops to trust for X-Forwarded-*; 0 = no proxy
TRUST_PROXY=0

# MongoDB must run as a replica set (transactions). `npm run db:dev` starts one on 27018.
MONGODB_URL=mongodb://127.0.0.1:27018/hajjcare?replicaSet=rs0
# MONGODB_REPLICA_SET=rs0   # alternative to ?replicaSet= in the URL
MONGODB_AUTO_INDEX=true

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are opaque random strings, not JWTs. Must be >= 45 (a Hajj runs ~40 days offline).
JWT_REFRESH_EXPIRATION_DAYS=60
REFRESH_ROTATION_GRACE_SECONDS=60
RESET_TOKEN_TTL_SECONDS=600

# At least 32 characters. OTP codes are stored as HMAC-SHA256 with this secret.
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=600
OTP_RESEND_AFTER_SECONDS=60
# Must be exactly 6: the app's copy says "six-digit" in seven languages.
OTP_LENGTH=6
# Must be >= 5.
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Must be exactly 8: the server must never be stricter than the client.
PASSWORD_MIN_LENGTH=8
# Used by user.model.js until bcrypt is replaced with argon2id.
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_IP_PER_HOUR=300

# dev writes emails to EMAIL_DEV_DIR; production requires smtp (+ SMTP_URL, EMAIL_FROM).
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@hajjcare.local
EMAIL_DEV_DIR=.dev-emails
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# RevenueCat webhook: shared secret (required, >= 32) and optional HMAC signing secret (>= 32).
RC_WEBHOOK_SECRET=
# RC_WEBHOOK_HMAC_SECRET=
HAJJCARE_ENTITLEMENT_ID=hajjcare_pass
