# HajjCare API on the VPS: copy to .env.production (never committed), fill in, chmod 600.
# Read by docker-compose.prod.yml. Validated at boot by src/config/config.js: the API refuses to
# start on a missing secret or an out-of-range value. Runbook: docs/VPS-RUNBOOK.md.
#
# Generate every secret below with:   openssl rand -base64 48
# Do not quote generated values. Never reuse a secret between staging and production.
# The CHANGE_ME placeholders are deliberately too short: the API refuses to start until replaced.

# Signs access tokens. At least 32 characters. Changing it signs every access token out (they refresh).
JWT_ACCESS_SECRET=CHANGE_ME
# HMAC key for stored OTP codes. At least 32 characters.
OTP_HMAC_SECRET=CHANGE_ME
# RevenueCat webhook Authorization header value; paste the same value in the RevenueCat dashboard.
RC_WEBHOOK_SECRET=CHANGE_ME
# Optional: RevenueCat's webhook signing secret (shown once in the dashboard). When set, requests must be signed.
# RC_WEBHOOK_HMAC_SECRET=

# Production refuses anything but smtp.
EMAIL_PROVIDER=smtp
# A Gmail App Password (2-Step Verification must be on), never the normal password; the @ in the username must be written %40.
SMTP_URL=smtps://YOUR_ADDRESS%40gmail.com:APP_PASSWORD_WITHOUT_SPACES@smtp.gmail.com:465
# Must be the same Gmail address, or Gmail rewrites the sender.
EMAIL_FROM="HajjCare <YOUR_ADDRESS@gmail.com>"

# Log verbosity: error | warn | info | http | debug.
LOG_LEVEL=info
# The entitlement id the app's RevenueCat build uses.
HAJJCARE_ENTITLEMENT_ID=hajjcare_pass

# Set by docker-compose.prod.yml itself, which overrides anything written here:
#   NODE_ENV=production
#   PORT=5000
#   MONGODB_URL=mongodb://mongo:27017/hajjcare?replicaSet=rs0
#   TRUST_PROXY=1
